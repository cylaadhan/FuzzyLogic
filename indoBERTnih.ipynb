    {
      "cell_type": "markdown",
      "source": [
        "# **Grafik Kategori Similarity**\n",
        "\n",
        "Nilai Similarity\tKategori\n",
        "≥ 0.90\tSangat Tinggi\n",
        "≥ 0.80\tTinggi\n",
        "≥ 0.70\tSedang\n",
        "< 0.70\tRendah"
      ],
      "metadata": {
        "id": "_irJVXUzjIbk"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def kategori_similarity(score):\n",
        "    if score >= 0.90:\n",
        "        return \"Sangat Tinggi\"\n",
        "    elif score >= 0.80:\n",
        "        return \"Tinggi\"\n",
        "    elif score >= 0.70:\n",
        "        return \"Sedang\"\n",
        "    else:\n",
        "        return \"Rendah\"\n",
        "\n",
        "df_grafik = df_hasil.copy()\n",
        "df_grafik[\"KATEGORI_SIMILARITY\"] = df_grafik[\"SIMILARITY\"].apply(kategori_similarity)\n",
        "\n",
        "kategori_count = df_grafik[\"KATEGORI_SIMILARITY\"].value_counts()\n",
        "\n",
        "plt.figure(figsize=(8, 5))\n",
        "plt.bar(kategori_count.index, kategori_count.values)\n",
        "plt.title(\"Jumlah Data Berdasarkan Kategori Similarity\")\n",
        "plt.xlabel(\"Kategori Similarity\")\n",
        "plt.ylabel(\"Jumlah Data\")\n",
        "plt.grid(axis=\"y\")\n",
        "plt.show()"
      ],
